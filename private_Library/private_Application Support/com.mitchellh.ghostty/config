# Acme-style colors
background = #ffffea
foreground = #000000
selection-background = #eaffff
selection-foreground = #000000
cursor-color = #000000
cursor-style = block
cursor-style-blink = false

# ANSI colors (muted, Plan 9 style)
palette = 0=#000000
palette = 1=#990000
palette = 2=#006600
palette = 3=#999900
palette = 4=#000099
palette = 5=#990099
palette = 6=#009999
palette = 7=#eeeeee
palette = 8=#666666
palette = 9=#cc0000
palette = 10=#00cc00
palette = 11=#cccc00
palette = 12=#0000cc
palette = 13=#cc00cc
palette = 14=#00cccc
palette = 15=#ffffff

font-feature = -calt
font-feature = -dlig
font-size = 15
font-family = "Go Mono"

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# Unfocused splits are clearly dimmed
unfocused-split-opacity = 0.8

window-inherit-working-directory = true

resize-overlay = never

# Input
keybind = shift+enter=text:\n

# Tab navigation (using cmd+shift to avoid conflict with split navigation)
keybind = shift+cmd+right=next_tab
keybind = shift+cmd+left=previous_tab

# Split navigation (using cmd+arrow)
keybind = cmd+left=goto_split:left
keybind = cmd+down=goto_split:bottom
keybind = cmd+up=goto_split:top
keybind = cmd+right=goto_split:right

# macOS window behavior with AeroSpace
# Disable native fullscreen to prevent conflicts with tiling WM
macos-non-native-fullscreen = true
